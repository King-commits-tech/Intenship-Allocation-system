# Copy this file to .env and adjust. Never commit your real .env file.

# Flask
FLASK_APP=run.py
FLASK_CONFIG=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=5000

# ---- Database --------------------------------------------------------
# Default: SQLite file at instance/internship.db (no installation needed)
DB_ENGINE=sqlite
# SQLITE_PATH=instance/internship.db

# To use MySQL, set DB_ENGINE=mysql and fill in the values below
# (create the database first: CREATE DATABASE internship_db CHARACTER SET utf8mb4;)
# DB_ENGINE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=internship
MYSQL_PASSWORD=
MYSQL_DATABASE=internship_db

# Or give a full SQLAlchemy URL (overrides everything above)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/internship_db?charset=utf8mb4

# ---- Uploads & security ---------------------------------------------
MAX_RESUME_MB=2
# UPLOAD_FOLDER=instance/uploads
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10
SESSION_COOKIE_SECURE=false       # set true when served over HTTPS

# ---- Matching -------------------------------------------------------
# SKILLS_FILE=app/data/skills.json  # custom skill dictionary
PAGE_SIZE=9
LOG_LEVEL=INFO
